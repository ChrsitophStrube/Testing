<?xml version="1.0"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="MyHMI.NavigationContent"
    xmlns="MyHMI.NavigationContent" elementFormDefault="qualified">
    <xs:element name="NavigationContent"/>

    <xs:element name="NavItem">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="NavItem" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attributeGroup ref="NavItemAttributes"/>
        </xs:complexType>
    </xs:element>

    <xs:attributeGroup name="NavItemAttributes">
        <xs:attribute name="Title" type="xs:string" use="required"/>
        <xs:attribute name="IconPath" type="xs:string" use="required"/>
        <xs:attribute name="ScreenPath" type="xs:string" default="" use="optional"/>
    </xs:attributeGroup>
</xs:schema>