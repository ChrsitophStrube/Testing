                                <CoT_FP_VarOutREAL text="Upstream Belt 3 Actual Positon" phi="${MODY1_Phi/Upstream_Belts/VarOut_Actual_Postn_Belt_3}" unit="Deg" decimalPlaces="1" />
                            </Structure>
                        </CoT_CMP_GroupBox>
                    </Structure>

                    <Structure Name="Column3/Area3" PathToNode="ScrollView/GridLayout">
                        <FacePlate FacePlateName="Move_Upstream_Belt1" />
                        <FacePlate FacePlateName="Move_Upstream_Belt2" />
                        <FacePlate FacePlateName="Move_Upstream_Belt3" />
                    </Structure>
                </Screen>
            </Screens>
            <Cfgs>

