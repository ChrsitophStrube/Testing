                                <CoT_CRTL_RadioButton text="Upstream Belt 3" optionID="${MODY1_Phi/Upstream_Belts/RadioButton_OptionID_Belt_3}" selectedOption="${MODY1_Phi/Upstream_Belts/RadioButton_SelectedOption_Belt_All}" />
